# ----------------------------
# Python
# ----------------------------
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so

# Virtual environments
venv/
.env/
ENV/
.venv/
env/

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Compiled / temporary files
*.log
*.tmp
*.bak

# ----------------------------
# Data + Output Files
# ----------------------------

# Ignore everything in data folder
data/**

# Ignore everything in output/outputs folders
output/**
outputs/**

# Keep .gitkeep files inside any of these
!data/**/.gitkeep
!output/**/.gitkeep
!outputs/**/.gitkeep

# ----------------------------
# IDE / OS specific files
# ----------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db

# ----------------------------
# Misc
# ----------------------------
*.sqlite3
*.db
*.lock
*.swp

# ----------------------------
# Always keep .gitkeep files
# ----------------------------
!.gitkeep
